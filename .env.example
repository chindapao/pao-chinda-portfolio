# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables
# for Production, Preview and Development. All are server-only (no NEXT_PUBLIC_ prefix) except NEXT_PUBLIC_SITE_URL.

# --- Contact form (Resend) -------------------------------------------------------------------------------------------
# https://resend.com/api-keys — "Sending access" is enough.
RESEND_API_KEY=
# Where contact messages are delivered.
CONTACT_EMAIL=
# Sender. Must be on a domain verified in Resend; the shared test sender only delivers to your own Resend account email.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# --- GitHub stats ---------------------------------------------------------------------------------------------------
GITHUB_USERNAME=chindapao
# Optional. A fine-grained token with no repository access (public data only) raises the rate limit to 5,000/h and
# enables "Contributions this year" (GraphQL). https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Site -----------------------------------------------------------------------------------------------------------
# Canonical URL used in metadata, sitemap and Open Graph. Set it to your custom domain once you have one.
NEXT_PUBLIC_SITE_URL=https://pao-chinda-portfolio.vercel.app
